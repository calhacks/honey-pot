  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "vitest --run",
    "lint": "pnpx oxlint src --config .oxlintrc.json --tsconfig tsconfig.json",
